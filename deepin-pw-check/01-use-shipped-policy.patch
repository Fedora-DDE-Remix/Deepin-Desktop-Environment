From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: mozixun <mozixun@fedoraproject.org>
Date: Sat, 21 Nov 2026 00:00:00 +0800
Subject: [PATCH] build: do not regenerate the shipped polkit policy

Fedora does not ship deepin-policy-ts-convert.  The translated policy file is
already present in misc/polkit-action.

diff --git a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -92 +92 @@
-build: prepare $(addprefix out/bin/, ${BINARIES}) out/${LIBRARIES} static_lib out/${PAM_MODULE} build_tool ts_to_policy
+build: prepare $(addprefix out/bin/, ${BINARIES}) out/${LIBRARIES} static_lib out/${PAM_MODULE} build_tool
