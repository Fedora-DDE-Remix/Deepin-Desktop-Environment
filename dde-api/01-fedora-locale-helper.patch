+// splitLocale splits zh_CN.UTF-8 into its source locale and charmap.
+func splitLocale(locale string) (lang, charset string) {
+	lang = locale
+	charset = "UTF-8"
+	if i := strings.Index(locale, "."); i >= 0 {
+		lang = locale[:i]
+		charset = locale[i+1:]
+	}
+	if i := strings.Index(charset, "@"); i >= 0 {
+		charset = charset[:i]
+	}
+	return lang, charset
+}
