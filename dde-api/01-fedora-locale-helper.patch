+// isFedoraLocaleSourceAvailable checks the glibc locale source and charmap
+// trees used by localedef.  Fedora has no /etc/locale.gen, so the Debian
+// parser alone would reject every locale.
+func isFedoraLocaleSourceAvailable(locale string) bool {
+	lang, charset := splitLocale(locale)
+	if lang == "" {
+		return false
+	}
+	if _, err := os.Stat("/usr/share/i18n/locales/" + lang); err != nil {
+		return false
+	}
+	charmap := "/usr/share/i18n/charmaps/" + charset
+	if _, err := os.Stat(charmap); err == nil {
+		return true
+	}
+	if _, err := os.Stat(charmap + ".gz"); err == nil {
+		return true
+	}
+	return false
+}
