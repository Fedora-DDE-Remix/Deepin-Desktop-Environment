 func (h *Helper) doGenLocaleWithParam(locale string) error {
+	// Fedora does not provide locale-gen or /etc/locale.gen.  Generate the
+	// locale directly from the glibc locale source shipped by
+	// glibc-locale-source.
+	if dutils.IsFileExist("/usr/bin/localedef") {
+		lang, charset := splitLocale(locale)
+		output, err := exec.Command("/usr/bin/localedef", "--no-archive", "-i", lang, "-f", charset, locale).CombinedOutput()
+		if err != nil {
+			return fmt.Errorf("localedef failed for %s: %v: %s", locale, err, strings.TrimSpace(string(output)))
+		}
