+// writeLocaleConf replaces LANG in /etc/locale.conf while preserving the
+// other locale variables that systemd and glibc may have written there.
+func writeLocaleConf(file, locale string) error {
+	var lines []string
+	if data, err := ioutil.ReadFile(file); err == nil {
+		for _, line := range strings.Split(string(data), "\n") {
+			trimmed := strings.TrimSpace(line)
+			if trimmed == "" || strings.HasPrefix(trimmed, "LANG=") {
+				continue
+			}
+			lines = append(lines, line)
+		}
+	}
+	lines = append(lines, "LANG="+locale)
+	return writeContentToFile(file, strings.Join(lines, "\n")+"\n")
+}
