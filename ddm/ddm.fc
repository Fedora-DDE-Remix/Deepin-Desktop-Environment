/usr/bin/ddm		--	gen_context(system_u:object_r:xdm_exec_t,s0)
/usr/libexec/ddm-helper	--	gen_context(system_u:object_r:xdm_exec_t,s0)
/run/ddm(/.*)?			gen_context(system_u:object_r:xdm_var_run_t,s0)
/var/lib/ddm(/.*)?		gen_context(system_u:object_r:xdm_var_lib_t,s0)

# treeland.service is started by DDM over systemd.  Label it as an XDM unit
# so xdm_t can use the existing start/status/stop allow rules.
/usr/lib/systemd/system/treeland.service -- gen_context(system_u:object_r:xdm_unit_file_t,s0)
